@page "/{culture}/help/faq"
@inherits PageCore<FaqPage>

<HeadComponent Title="FAQ" Url=@($"/{Culture}/help/faq") Description="@($"Find answers to common questions about {AppInfo.Title}, including accounts, destination lists, recommendations, subscriptions, and platform usage.")" Index="true"></HeadComponent>
<PageSectionComponent IsPageHeader="true" Title="FAQ" Description="@($"Find answers to common questions about {AppInfo.Title}, including accounts, destination lists, recommendations, subscriptions, and platform usage.")"></PageSectionComponent>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.PrivacyTip" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Privacy & Data</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="What user data does the platform collect?" HeaderClass="mud-secondary-text">
        We collect minimal data necessary for platform functionality, including email for login, account preferences, nationality, passport issuing country, and usage metadata like IP and login times. Sensitive personal information is not shared or sold.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Are my lists and data shared with others?" HeaderClass="mud-secondary-text">
        Private lists and personal notes are visible only to you. Public destination content is visible to all users.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Can I delete my account and data?" HeaderClass="mud-secondary-text">
        Yes, you can delete your account at any time, which removes your saved lists, notes, and personal preferences from our system.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.ListAlt" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Lists & Destination Management</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Can I create and manage my own lists?" HeaderClass="mud-secondary-text">
        Yes, you can create private lists for destinations, past trips, and future travel plans. Premium increases the number of destinations, past trips, and upcoming trips you can save.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How do personalized recommendations work?" HeaderClass="mud-secondary-text">
        Recommendations are based on your profile, past trips, preferred destinations, and lifestyle preferences. Users should verify critical information independently before making travel decisions.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Can I share my private lists?" HeaderClass="mud-secondary-text">
        Private lists cannot currently be shared as a list. You can still share individual destination pages using their public links.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.AccountCircle" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Account & Access</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Do I need to create an account?" HeaderClass="mud-secondary-text">
        No account is required to explore public content and lists. Creating an account enables personal destination management, private lists, and recommendations.
    </MudExpansionPanel>
    <MudExpansionPanel Text="What information is required to register?" HeaderClass="mud-secondary-text">
        Only an email address is required to register. Additional optional data may include nationality and passport issuing country for personalized recommendations.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.Payment" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Subscriptions & Payments</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Is the platform free?" HeaderClass="mud-secondary-text">
        Yes, basic access is free. Premium subscriptions let you save more wishlist items, travel history entries, and upcoming trips.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How do I manage my subscription?" HeaderClass="mud-secondary-text">
        You can manage or cancel your subscription through the payment provider used for your purchase. Available options depend on the provider.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How is payment processed?" HeaderClass="mud-secondary-text">
        Payments are processed by the payment provider you select at checkout. Full payment details are handled by that provider and are not stored on our servers.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudExpansionPanels Outlined="true" Elevation="0" Class="@CssHelper.Build().Medium("mb")">
    <MudExpansionPanel Disabled="true" HideIcon="true">
        <TitleContent>
            <div class="d-flex">
                <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.HelpOutline" class="@CssHelper.Build().Small("mr")"></MudIcon>
                <MudText Color="Color.Primary">Usage & Support</MudText>
            </div>
        </TitleContent>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Does the platform provide official travel or government advice?" HeaderClass="mud-secondary-text">
        No, the platform aggregates public and third-party information. Users must verify visas, residency, taxes, and other official requirements with official sources before making decisions.
    </MudExpansionPanel>
    <MudExpansionPanel Text="How can I contact support?" HeaderClass="mud-secondary-text">
        You can contact support via the in-app feedback section or by emailing support@my-next-spot.com.
    </MudExpansionPanel>
    <MudExpansionPanel Text="What languages does the platform support?" HeaderClass="mud-secondary-text">
        The platform interface is available in English, Portuguese, Spanish, Chinese, French, Italian, and German. Destination data may be available in additional languages, depending on its source.
    </MudExpansionPanel>
</MudExpansionPanels>
