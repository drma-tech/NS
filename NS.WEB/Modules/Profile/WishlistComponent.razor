@inherits ComponentCore<WishlistComponent>

@inject WishListApi WishListApi

<PageSectionComponent Icon="@IconsFA.Solid.Icon("plane-circle-exclamation").Font" Title="@Translations.Title.Wishlist">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@Add">
            @Translations.Button.Add
        </MudButton>
    </ActionsFragment>
    <BodyFragment>
        <RenderControl State="State">
             <Slider List="@(WishList?.Items ?? new HashSet<WishListEntry>())" Context="ctx">
                <div style="@($"width: {(AppStateStatic.IsMobile ? "150" : "200")}px;")">
                    <div style="position: relative;">
                        <MudCard Outlined="true">
                            <MudCardMedia Image="@ctx?.RegionCode.GetFlag()" Height="100" />
                            <MudCardHeader Style="text-align: initial;" Class="pa-2">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">@ctx?.RegionName</MudText>
                                    <MudText Typo="Typo.body2">@(ctx?.CityName ?? "-")</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardActions Style="align-self: center;">
                                <MudTooltip Text="Update">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => Update(ctx))" Size="Size.Small" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => Delete(ctx))" Size="Size.Small" />
                                </MudTooltip>
                                <MudTooltip Text="Confirm Next Destination">
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" OnClick="@(() => ConfirmNextDestination(ctx))" Size="Size.Small" />
                                </MudTooltip>
                            </MudCardActions>
                        </MudCard>
                    </div>
                </div>
             </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>