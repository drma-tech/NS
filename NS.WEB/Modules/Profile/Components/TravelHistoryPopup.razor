@using NS.WEB.Modules.Country.Core
@using NS.WEB.Modules.Profile.Core
@inherits ComponentCore<TravelHistoryPopup>

@inject RegionsApi RegionsApi
@inject TravelHistoryApi TravelHistoryApi

<MudDialog Style="width: 100%;">
    <DialogContent>
        <MudTabs Border="true" Outlined="true" TabPanelsClass="pt-4" MinimumTabWidth="100px">
            <MudTabPanel Text="Details">
                <MudGrid Spacing="@CssHelper.SpaceSmall">
                    <MudItem xs="12" sm="8">
                        @{
                            TimeSpan duration = _dateRange?.Start != null && _dateRange?.End != null ? _dateRange.End.Value - _dateRange.Start.Value : new();
                        }
                        <MudDateRangePicker @ref="_picker" Label="Travel period" @bind-DateRange="_dateRange" PickerVariant="PickerVariant.Inline" Variant="Variant.Outlined"
                                            MaxDate="DateTime.Today" AutoClose="true" HelperText="@duration.Humanize(2, minUnit: TimeUnit.Day, maxUnit: TimeUnit.Year)">
                            <PickerActions>
                                <MudButton OnClick="@(() => _picker.CloseAsync(false))">@Translations.Button.Cancel</MudButton>
                                <MudButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">@Translations.Button.Ok</MudButton>
                            </PickerActions>
                        </MudDateRangePicker>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect Label="Continent" @bind-Value="@continent" @bind-Value:after="@ContinentChanged" Clearable="true" Dense="true" FullWidth="true" Variant="Variant.Outlined">
                            @foreach (var item in AllRegions?.GetContinents() ?? [])
                            {
                                <MudSelectItem T="string" Value="item">@item</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect Label="Region" @bind-Value="@Entry.RegionCode" TextChanged="@RegionChanged" Clearable="true" Dense="true" FullWidth="true" Variant="Variant.Outlined"
                                   Disabled="@(AllRegions?.GetList(continent, null, true).Empty() ?? true)">
                            @foreach (var item in AllRegions?.GetList(continent, null, true) ?? [])
                            {
                                <MudSelectItem T="string" Value="@item.code">@item.name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="d-flex flex-column mt-3">
                            <MudRating SelectedValue="@(Entry.RegionRating ?? 0)" SelectedValueChanged="@((int vl) => { Entry.RegionRating = vl; if (vl == 0) Entry.RegionRating = null; })"
                                       MaxValue="10" HoveredValueChanged="RegionValueChanged" Color="@GetRatingColor(regionTempValue ?? Entry.RegionRating)" Disabled="Entry.RegionCode.Empty()" />
                            <MudText Typo="Typo.caption" Color="@GetRatingColor(regionTempValue ?? Entry.RegionRating)">
                                @LabelText(regionTempValue, Entry.RegionRating)
                            </MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect Label="City" @bind-Value="@Entry.CityCode" @bind-Value:after="@CityChanged" Clearable="true" Dense="true" Variant="Variant.Outlined" FullWidth="true"
                                   Disabled="@(RegionData?.Cities.Empty() ?? true)">
                            @foreach (var item in RegionData?.Cities.ToList() ?? [])
                            {
                                <MudSelectItem T="string" Value="@item.ToSlug()">@item</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="d-flex flex-column mt-3">
                            <MudRating SelectedValue="@(Entry.CityRating ?? 0)" SelectedValueChanged="@((int vl) => { Entry.CityRating = vl; if (vl == 0) Entry.CityRating = null; })"
                                       MaxValue="10" HoveredValueChanged="CityValueChanged" Color="@GetRatingColor(cityTempValue ?? Entry.CityRating)" Disabled="Entry.CityCode.Empty()" />
                            <MudText Typo="Typo.caption" Color="@GetRatingColor(cityTempValue ?? Entry.CityRating)">
                                @LabelText(cityTempValue, Entry.CityRating)
                            </MudText>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="Notes">
                <MudTextField @bind-Value="Entry.Notes" Label="Your notes" Variant="Variant.Outlined" FullWidth="true" Lines="10" />
            </MudTabPanel>
            <MudTabPanel Text="Photos">
                <FeatureUnavailable></FeatureUnavailable>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Cancel
        </MudButton>
        <MudButton OnClick="Save" Color="Color.Primary">
            @Translations.Button.Save
        </MudButton>
    </DialogActions>
</MudDialog>