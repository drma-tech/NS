@inherits ComponentCore<TravelHistoryComponent>

@inject TravelHistoryApi TravelHistoryApi

<PageSectionComponent Icon="@IconsFA.Solid.Icon("clock-rotate-left").Font" Title="@Translations.Title.TravelHistory" Description="@Translations.Module.Profile.TravelHistoryDesc">
    <ActionsFragment>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" OnClick="@Add">
            @Translations.Button.Add
        </MudButton>
        <MudSpacer></MudSpacer>
        <MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => { Navigation.NavigateTo($"/{Culture}/profile/travel-history"); })" />
    </ActionsFragment>
    <BodyFragment>
        <RenderControl State="State">
             <Slider List="@(TravelHistory?.Items.OrderByDescending(p => p.StartDate).Take(5) ?? [])" Context="ctx">
                @{
                    var duration = ctx.EndDate.ToDateTime(TimeOnly.MinValue) - ctx.StartDate.ToDateTime(TimeOnly.MinValue);
                }
                <div class="swiper-slide" style="@($"width: {(AppStateStatic.IsMobile ? "150" : "200")}px;")">
                    <div style="position: relative;">
                        <MudCard Outlined="true">
                            <MudCardMedia Image="@ctx?.RegionCode.GetFlag()" Height="100" />
                            <MudChip T="string" Label="true" Class="poster-chip" Style="top: 0; left: 0;" Size="AppStateStatic.Size" Color="Color.Info">
                                @ctx?.StartDate.ToShortDateString()
                            </MudChip>
                            <MudChip T="string" Label="true" Class="poster-chip" Style="top: 24px; left: 0;" Size="AppStateStatic.Size" Color="Color.Info">
                                @duration.Humanize(2, minUnit: TimeUnit.Day, maxUnit: TimeUnit.Year)
                            </MudChip>
                            <MudCardHeader Style="text-align: initial;" Class="pa-2">
                                <CardHeaderContent>
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">@ctx?.RegionName</MudText>
                                    <MudText Typo="Typo.body2">@(ctx?.CityName ?? "-")</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardActions Style="align-self: center;">
                                <MudTooltip Text="Update">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => Update(ctx))" Size="Size.Small" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => Delete(ctx))" Size="Size.Small" />
                                </MudTooltip>
                            </MudCardActions>
                        </MudCard>
                    </div>
                </div>
             </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>