@using NS.Shared.Models.GlobalConflicts
@using NS.WEB.Shared.Field.View
@inherits ComponentCore<ConflictsComponent>

@inject GlobalConflictsApi GlobalConflictsApi
@inject AllRegionsApi AllRegionsApi

<PageSectionComponent Title="@Translations.Module.Country.ConflictsOverview" Description="@Translations.Module.Country.ConflictsDescription">
    <BodyFragment>
        <RenderControl State="State" Context="ctx">
            @if (Items.NotEmpty())
            {
                <MudGrid Spacing="@CssHelper.SpaceSmall">
                    @foreach (var item in Items)
                    {
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent Class="@CssHelper.Build().Small("pa")">
                                    <MudText Color="Color.Secondary">
                                        @item.title
                                    </MudText>
                                </MudCardContent>
                                <MudCardContent Class="@CssHelper.Build().Small("px").Small("pb").Raw("pt-0")">
                                    <CustomChips Name="Parties" Values="item.state_parties.Select(p => AllRegions?.Items.Single(s => p.Equals(s.code3, StringComparison.InvariantCultureIgnoreCase)).name)" Size="Size.Small"></CustomChips>
                                    <CustomChips Values="item.non_state_parties" Size="Size.Small" HideIfEmpty="true"></CustomChips>
                                </MudCardContent>
                                <MudCardContent Class="@CssHelper.Build().Small("px").Small("pb").Raw("pt-0")">
                                    <CustomChips Name="Violations" Values="item.violations" Size="Size.Small"></CustomChips>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Info" Style="text-align: justify;">
                    @Translations.Notification.RenderControlNoData
                </MudAlert>
            }
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

@code {
    [Parameter][EditorRequired] public string? Code { get; set; }

    public RenderControlState<GlobalConflictsCache?> State { get; set; } = new(null, obj => obj?.Data == null || obj.Data.Items.Empty());
    private GlobalConflictsCache? Conflicts { get; set; }

    private List<GlobalConflictsItem> Items => Conflicts?.Data?.Items
       .Where(x => x.state_parties.Any(p => p.Equals(Region?.code3, StringComparison.InvariantCultureIgnoreCase))).ToList() ?? [];

    private AllRegions? AllRegions { get; set; }
    private RegionModel? Region { get; set; }

    protected override async Task LoadStaticDataAsync()
    {
        Conflicts = await GlobalConflictsApi.GetConflicts([State], Cts.Token);

        AllRegions = await AllRegionsApi.GetAllRegions(Cts.Token);
        Region = AllRegions?.Items.SingleOrDefault(r => r.code!.Equals(Code, StringComparison.InvariantCultureIgnoreCase));
    }

    private string? GetIcon(string? status)
    {
        if (status == null) return IconsFA.Solid.Icon("xmark").Font;

        string icon;

        if (status == "Worsening") icon = "face-frown";
        else if (status == "Unchanging") icon = "face-meh";
        else if (status == "Improving") icon = "face-smile-beam";
        else return IconsFA.Solid.Icon("xmark").Font;

        return IconsFA.Solid.Icon(icon).Font;
    }

    private string GetColor(string? status)
    {
        if (status == null) return "color: inherit;";

        int bucket;

        if (status == "Worsening") bucket = 0;
        else if (status == "Unchanging") bucket = 1;
        else if (status == "Improving") bucket = 2;
        else return "color: inherit;";

        var colors = new[]
        {
            "rgb(255, 122, 82)",  // bad
            "rgb(255, 181, 69)",  // medium
            "rgb(173, 192, 88)",  // good
        };

        return $"color: {colors[bucket]};";
    }
}
