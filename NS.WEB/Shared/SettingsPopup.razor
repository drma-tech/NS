@inherits ComponentCore<SettingsPopup>

@inject IpInfoApi IpInfoApi

<MudDialog Style="width: 100%">
    <DialogContent>
        <MudGrid Spacing="@CssHelper.SpaceMedium">
            <MudItem xs="12">
                <MudSelect Value="@Language" ValueChanged="@((AppLanguage vl) => AppLanguageValueChanged(vl))" Label="@Translations.Module.Help.AppLanguage"
                           HelperText="@Translations.Module.Help.AppLanguageDesc" FullWidth="true">
                    @foreach (var item in appLanguages.OrderBy(p => p.Name))
                    {
                        <MudSelectItem Value="@item.Value">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudText Class="mb-1" Style="font-size: 14px;">Temperature Scale</MudText>
                <MudToggleGroup Value="Temperature" ValueChanged="(Temperature vl) => TemperatureChanged(vl)" SelectionMode="SelectionMode.SingleSelection"
                                Vertical="false" Color="Color.Primary">
                    <MudToggleItem Value="Temperature.Celsius">
                        @Temperature.Celsius.GetFieldSettings()?.Name
                    </MudToggleItem>
                    <MudToggleItem Value="Temperature.Fahrenheit">
                        @Temperature.Fahrenheit.GetFieldSettings()?.Name
                    </MudToggleItem>
                </MudToggleGroup>
            </MudItem>
            <MudItem xs="12">
                <MudText Class="mb-1" Style="font-size: 14px;">@Translations.Module.Help.AppTheme</MudText>
                <MudToggleGroup Value="DarkMode" ValueChanged="(bool vl) => DarkModeChanged(vl)" SelectionMode="SelectionMode.SingleSelection"
                                Vertical="false" Color="Color.Primary">
                    <MudToggleItem Value="false">
                        <MudIcon Icon="@Icons.Material.Filled.LightMode" Title="@Translations.Module.Help.LightMode" Class="me-1"></MudIcon>
                        @Translations.Module.Help.LightMode
                    </MudToggleItem>
                    <MudToggleItem Value="true">
                        <MudIcon Icon="@Icons.Material.Filled.DarkMode" Title="@Translations.Module.Help.DarkMode" Class="me-1"></MudIcon>
                        @Translations.Module.Help.DarkMode
                    </MudToggleItem>
                </MudToggleGroup>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>
