@typeparam TValue

<MudChip T="string" Variant="Variant.Outlined" Size="AppStateStatic.Size" Color="@(Value != null ? Color.Info : Color.Default)" Class="mx-0" Style="width: 100%; justify-content: space-between;">
    @if (OnlyLabel)
    {
        @Name
        <MudTooltip Text="@Placeholder">
            <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Default" Style="margin-inline: -6px; cursor: help; vertical-align: middle;"></MudIcon>
        </MudTooltip>
    }
    else if (Value is bool resultB)
    {
        <MudIcon Icon="@(resultB ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(resultB ? Color.Success : Color.Error)"
                 Style="margin-inline: -6px;"></MudIcon>
        @if (ShowLabel)
        {
            <MudTooltip Text="@Placeholder">
                <span style="font-weight: bold; text-decoration: underline; cursor: help;">@Name</span>
            </MudTooltip>
        }
        @if (Description.NotEmpty())
        {
            <MudTooltip Text="@Description">
                <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Default" Style="margin-inline: -6px; cursor: help; vertical-align: middle;"></MudIcon>
            </MudTooltip>
        }
        else
        {
            <span></span>
        }
    }
    else if (Nullable.GetUnderlyingType(typeof(TValue))?.IsEnum == true)
    {
        var resultE = (Enum?)(object?)Value;

        if (resultE == null)
        {
            <MudIcon Icon="@GetIntIcon(null)" Style="margin-inline: -6px;"></MudIcon>
        }
        else
        {
            int? intValue = resultE != null ? Convert.ToInt32(resultE) : null;
            <MudIcon Icon="@GetIntIcon(intValue)" Style="@($"margin-inline: -6px; {GetColorStyle(intValue)}")"></MudIcon>
        }
        <div>
            @if (ShowLabel)
            {
                <MudTooltip Text="@Placeholder">
                    <span style="font-weight: bold; text-decoration: underline; cursor: help;" class="me-1">@Name: </span>
                </MudTooltip>
                <span>@resultE?.GetFieldSettings().Name</span>
            }
            else
            {
                <MudTooltip Text="@Placeholder">
                    <span style="font-weight: bold; text-decoration: underline; cursor: help;">@resultE?.GetFieldSettings().Name</span>
                </MudTooltip>
            }
        </div>
        @if (Description.NotEmpty())
        {
            <MudTooltip Text="@Description">
                <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Default" Style="margin-inline: -6px; cursor: help; vertical-align: middle;"></MudIcon>
            </MudTooltip>
        }
        else
        {
            <span></span>
        }
    }
    else if (typeof(TValue) == typeof(double?))
    {
        var resultD = Value as double?;

        <MudIcon Icon="@GetIntIcon(ForceScore ? Score : (double?)(object?)Value)" Style="@($"margin-inline: -6px; {GetColorStyle(ForceScore ? Score : (double?)(object?)Value)}")"></MudIcon>
        <div>
            @if (ShowLabel)
            {
                <MudTooltip Text="@Placeholder">
                    <span style="font-weight: bold; text-decoration: underline; cursor: help;" class="me-1">@Name: </span>
                </MudTooltip>
            }
            <span>@resultD?.ToString("#.##", UsCulture)</span>
        </div>
        @if (Description.NotEmpty())
        {
            <MudTooltip Text="@Description">
                <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Default" Style="margin-inline: -6px; cursor: help; vertical-align: middle;"></MudIcon>
            </MudTooltip>
        }
        else
        {
            <span></span>
        }
    }
    else if (typeof(TValue) == typeof(decimal?))
    {
        var resultD = Value as decimal?;

        <MudIcon Icon="@GetIntIcon(Score)" Style="@($"margin-inline: -6px; {GetColorStyle(Score)}")"></MudIcon>
        <div>
            @if (ShowLabel)
            {
                <MudTooltip Text="@Placeholder">
                    <span style="font-weight: bold; text-decoration: underline; cursor: help;" class="me-1">@Name: </span>
                </MudTooltip>
            }
            <span>@resultD?.ToString("C", UsCulture)</span>
        </div>
        @if (Description.NotEmpty())
        {
            <MudTooltip Text="@Description">
                <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Default" Style="margin-inline: -6px; cursor: help; vertical-align: middle;"></MudIcon>
            </MudTooltip>
        }
        else
        {
            <span></span>
        }
    }
    else if (typeof(TValue) == typeof(string))
    {
        var resultD = Value as string;

        <MudIcon Icon="@GetIntIcon(Score)" Style="@($"margin-inline: -6px; {GetColorStyle(Score)}")"></MudIcon>
        <div>
            @if (ShowLabel)
            {
                <MudTooltip Text="@Placeholder">
                    <span style="font-weight: bold; text-decoration: underline; cursor: help;" class="me-1">@Name: </span>
                </MudTooltip>
            }
            <span>@resultD</span>
        </div>
        @if (Description.NotEmpty())
        {
            <MudTooltip Text="@Description">
                <MudIcon Icon="@Icons.Material.Filled.Help" Color="Color.Default" Style="margin-inline: -6px; cursor: help; vertical-align: middle;"></MudIcon>
            </MudTooltip>
        }
        else
        {
            <span></span>
        }
    }
    else
    {
        <MudText Color="Color.Error">Not Implemented</MudText>
    }
</MudChip>