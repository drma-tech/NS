@inherits ComponentCore<ExternalWebsitePopup>

<MudDialog Style="width: 100%;">
    <DialogContent>
        <div style="text-align:left; line-height:1.5; font-size:14px;">
            <p>@Message</p>
            <div style="background-color:#f5f5f5; padding:8px; border-radius:6px; word-break:break-word; color:black; font-family:monospace; font-size:13px; margin:8px 0;">
                @ExternalUrl
            </div>
        </div>

        <Advertising Slot="@AdSlot.Header" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">
            @Translations.Button.Cancel
        </MudButton>
        <MudButton OnClick="Continue" Color="Color.Primary">
            @Translations.Button.ContinueWebsite
        </MudButton>
    </DialogActions>
</MudDialog>
